{
  "name": "tattoo-app",
  "version": "0.2.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@mui/x-data-grid": "^7.24.0",
    "axios": "^1.7.9",
    "moment": "^2.30.1",
    "react": "^18.3.1",
    "react-big-calendar": "^1.17.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "rules": {
      "no-restricted-syntax": [
        "error",
        {
          "selector": "Literal[value=/^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/]",
          "message": "Hardcoded hex colors are not allowed. Use design tokens from src/theme.js."
        },
        {
          "selector": "TemplateElement[value.raw=/#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})\\b/]",
          "message": "Hardcoded hex colors are not allowed. Use design tokens from src/theme.js."
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "src/theme.js"
        ],
        "rules": {
          "no-restricted-syntax": "off"
        }
      }
    ]
  }
}
